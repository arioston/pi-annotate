{
  "manifest_version": 3,
  "name": "Pi Annotate",
  "version": "0.5.0",
  "description": "Visual annotation tool for Pi coding agent",
  
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  
  "devtools_page": "devtools/devtools.html",

  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/fn.js",
        "lib/safe-runtime.js",
        "panel/protocol.js",
        "tailedit/tw-spacing.js",
        "tailedit/tw-default-classes.js",
        "tailedit/tw-v4-data.js",
        "tailedit/tw-theme.js",
        "tailedit/controls/spacing.js",
        "tailedit/controls/typography.js",
        "tailedit/controls/color.js",
        "tailedit/suggest.js",
        "tailedit/overlay.js",
        "tailedit/guides.js",
        "tailedit/editor.js",
        "xray/measure.js",
        "xray/overlay.js",
        "xray/controller.js",
        "lib/capture-plan.js",
        "lib/page-capture-client.js",
        "capture/page.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle element picker"
    },
    "toggle-xray": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle X-ray measurements"
    },
    "capture-full-page": { "description": "Capture the full page" }
  },
  
  "action": {
    "default_title": "Pi Annotate",
    "default_popup": "popup.html"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
